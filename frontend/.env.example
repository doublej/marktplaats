# Auth.js configuration
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# API token auth — remote clients send "Authorization: Bearer <token>"
# Generate a token: openssl rand -hex 32 (unset/empty disables bearer auth)
MP_API_TOKEN=

# User id that bearer-token requests act as (fallback: "api:token")
# Hint: log in at the site, then open /api/me to read your userId
MP_API_USER_ID=

# Background watch scheduler (default on; set to 0 or false to disable)
WATCH_SCHEDULER=
