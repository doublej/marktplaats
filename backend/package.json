{
  "name": "marktplaats-js",
  "version": "0.1.0",
  "description": "Marktplaats.nl scraper library for Bun/Node.js",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "marktplaats": "./src/cli/index.ts",
    "marktplaats-mcp": "./src/mcp/index.ts"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./server": {
      "import": "./src/server/exports.ts",
      "types": "./src/server/exports.ts"
    },
    "./ops": {
      "import": "./src/ops/index.ts",
      "types": "./src/ops/index.ts"
    },
    "./mcp": {
      "import": "./src/mcp/server.ts",
      "types": "./src/mcp/server.ts"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check src/",
    "lint:fix": "bunx @biomejs/biome check --fix src/",
    "server": "bun run src/server/index.ts",
    "server:dev": "bun --watch src/server/index.ts",
    "cli": "bun src/cli/index.ts",
    "mcp": "bun src/mcp/index.ts",
    "mcp:dev": "bun --watch src/mcp/index.ts",
    "recon:syi": "bun scripts/recon-mp-syi.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "playwright": "^1.59.1",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "marktplaats",
    "scraper",
    "classifieds",
    "netherlands"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  }
}
