# Marktplaats poster — session encryption key.
# Generate: openssl rand -base64 32
# Required for `mp:link`, `mp:create-ad`, and HTTP /mp-accounts + /ads routes.
# Min 16 chars. Keep secret. Losing this key makes stored session blobs undecryptable.
MP_POSTER_KEY=

# Optional: override default JSON storage path (default: ./marktplaats-watches.json).
# WATCH_STORAGE_PATH=
